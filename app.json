{
  "expo": {
    "name": "komposvision",
    "slug": "komposvision",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-komposvision.png",
    "scheme": "komposvision",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo-komposvision.png",
        "backgroundImage": "./assets/images/logo-komposvision.png",
        "monochromeImage": "./assets/images/logo-komposvision.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.komposvision"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-komposvision.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-komposvision.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "990fb04e-0074-4c75-ac46-6fd9c44b8cad"
      }
    },
    "owner": "kadekpindras-organization"
  }
}
